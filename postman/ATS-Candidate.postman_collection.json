                "exec": [
                  "pm.test(\"Status 409 Conflict\", () => {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Codigo EMAIL_ALREADY_EXISTS\", () => {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.code).to.eql(\"EMAIL_ALREADY_EXISTS\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
