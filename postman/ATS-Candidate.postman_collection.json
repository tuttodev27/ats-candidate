              "raw": "{\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"email\": \"juan.perez@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/candidates",
              "host": ["{{base_url}}"],
              "path": ["api", "candidates"]
            },
            "description": "Debe ejecutarse después de 'Crear postulante (solo datos basicos)'."
          }
